include   CHANGELOG.md   CODE_OF_CONDUCT.md   CONTRIBUTING.md   LICENSE.md   MANIFEST.in   README.md   pyproject.toml

global-exclude   *~   *.py[cod]   *.so   .DS_Store

prune .*/
prune **/__pycache__/

# The sdist carries only what is needed to build the package. The test suite is
# not shipped: its fixtures are ~315 MB, it cannot run without them, and the
# example audio it reads by relative path exists only for those tests and the
# documentation. Both live in git for CI and for anyone working from a clone.
prune src/birdnet_tests/
prune example/
